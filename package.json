{
  "name": "ai-approval-reviewer",
  "description": "Independent AI reviewer for one-shot agent approval requests",
  "version": "0.1.1-rc.2",
  "author": "zhangweiii",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ai-approval-repair-history": "scripts/repair-ai-approval-history.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangweiii/dsh-ai-approval.git"
  },
  "homepage": "https://github.com/zhangweiii/dsh-ai-approval#readme",
  "bugs": {
    "url": "https://github.com/zhangweiii/dsh-ai-approval/issues"
  },
  "keywords": [
    "ai",
    "approval",
    "reviewer",
    "deepseek",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/license-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "release": "bash scripts/publish.sh",
    "release:check": "node scripts/release-check.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "smoke": "node scripts/package-smoke.mjs",
    "history:repair": "node scripts/repair-ai-approval-history.mjs",
    "check": "pnpm format:check && pnpm test && pnpm typecheck && pnpm coverage && pnpm release:check && pnpm license:check && pnpm sbom:check && pnpm build && pnpm publint && pnpm smoke",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.cjs"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.cjs",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml",
    "scripts/repair-ai-approval-history.mjs"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@vitest/coverage-v8": "4.1.8",
    "prettier": "3.6.2",
    "publint": "0.3.14",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
